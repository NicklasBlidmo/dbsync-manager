# Copy to .env. Fill in the two keys with (needs Python 3 on the host):
#   python3 manager/generate_keys.py --write .env
# or, without Python on the host, print them with the image and paste them:
#   docker compose run --rm --no-deps --entrypoint python manager generate_keys.py

# --- registry database (design §10, §12) ---
# The role in DATABASE_URL owns the dbsync_manager schema and nothing else.
# It is *not* the role syncs run as; those are entered in the UI.
#
# Existing PostGIS server (the normal case): point DATABASE_URL at it. From
# inside the container "localhost" is the container itself, so use the
# server's LAN address or a shared Docker network. Prepare the role with one of:
#   GRANT CREATE ON DATABASE <db> TO <role>;               -- manager creates the schema
#   CREATE SCHEMA dbsync_manager AUTHORIZATION <role>;     -- least privilege
# DATABASE_URL=postgres://dbsync_manager:change-me@192.0.2.10:5432/gis
#
# Bundled PostGIS: set COMPOSE_PROFILES=postgis and the three passwords.
# docker/postgis-init/10-manager.sh creates the registry role dbsync_manager
# with MANAGER_DB_PASSWORD on the first start; DATABASE_URL must use the same
# password (env files are not interpolated, so it is written twice).
DATABASE_URL=postgres://dbsync_manager:change-me-too@postgis:5432/gis
# COMPOSE_PROFILES=postgis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gis
MANAGER_DB_PASSWORD=change-me-too

# --- secrets ---
# Fill both in on these lines with:
#   python3 manager/generate_keys.py --write .env
# Do not add second lines for them: the last line for a key wins, so an empty
# one left below a filled-in one gives an empty key.
DJANGO_SECRET_KEY=
# Fernet key for credentials stored in the registry. Losing it means every
# stored Mergin account and database password must be re-entered (§10).
# Keep a copy outside the server, and never replace it once credentials exist.
DBSYNC_MANAGER_SECRET_KEY=

# --- web ---
# Address and port on the host. BIND_IP=0.0.0.0 listens on every interface;
# set the LAN address to stay off the others. Pick a free port:
#   ss -ltn | grep -w 8080
BIND_IP=0.0.0.0
HTTP_PORT=8080
# Every host name or IP address people type in the browser; anything else
# gets HTTP 400. localhost and 127.0.0.1 are always allowed (healthcheck).
ALLOWED_HOSTS=
# Set when behind a reverse proxy with TLS, e.g. https://dbsync.example.org
CSRF_TRUSTED_ORIGINS=
# Send session/CSRF cookies only over HTTPS. Turn on behind a TLS proxy, and
# only then: over plain HTTP the browser drops them and no form can be posted.
SECURE_COOKIES=false
DJANGO_DEBUG=false
# gunicorn access log (one line per HTMX poll); off unless 1.
WEB_ACCESS_LOG=0
# Clock for all log lines and for dates in the UI, e.g. Europe/Stockholm.
TZ=UTC

# --- e-mail alerts (optional; console output when SMTP_HOST is empty) ---
# Leave SMTP_USER and SMTP_PASSWORD empty to send without AUTH, e.g. through
# Microsoft 365 direct send (docs/m365-direct-send.md): host = the tenant's
# MX host, port 25, SMTP_TLS=true (STARTTLS), FROM on the tenant's domain.
# Test with: docker compose exec manager python manage.py sendtestemail you@example.org
# Recipients are set per project. The link in each mail uses this address.
DBSYNC_BASE_URL=http://localhost:8080
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_TIMEOUT=30
SMTP_FROM=dbsync-manager@example.org

# --- supervisor tuning (seconds) ---
DBSYNC_TICK=30
DBSYNC_CHECK_INTERVAL=300
DBSYNC_STUCK_AFTER=1800
DBSYNC_LOG_MAX_MB=20
DBSYNC_LOG_KEEP=5
DBSYNC_RETENTION_DAYS=90
# Seconds to wait for the database at start, and to pause before a failed
# start is retried.
DBSYNC_DB_WAIT=30
DBSYNC_FAIL_DELAY=30

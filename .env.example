# Copy to .env. Generate the two keys with:
#   docker compose run --rm --no-deps manager python manage.py generate_keys

# --- registry database (design §10, §12) ---
# The role in DATABASE_URL owns the dbsync_manager schema and needs CREATE on
# the database. It is *not* the role syncs run as; those are entered in the UI.
# With the bundled postgis service the values below match POSTGRES_* here.
DATABASE_URL=postgres://postgres:change-me@postgis:5432/gis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=gis

# --- secrets ---
DJANGO_SECRET_KEY=
# Fernet key for credentials stored in the registry. Losing it means every
# stored Mergin account and database password must be re-entered (§10).
DBSYNC_MANAGER_SECRET_KEY=

# --- web ---
ALLOWED_HOSTS=localhost,127.0.0.1
# Set when behind a reverse proxy with TLS, e.g. https://dbsync.example.org
CSRF_TRUSTED_ORIGINS=
# Send session/CSRF cookies only over HTTPS. Turn on behind a TLS proxy.
SECURE_COOKIES=false
DJANGO_DEBUG=false

# --- e-mail alerts (optional; console output when SMTP_HOST is empty) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_FROM=dbsync-manager@example.org

# --- supervisor tuning (seconds) ---
DBSYNC_TICK=30
DBSYNC_CHECK_INTERVAL=300
DBSYNC_STUCK_AFTER=1800
DBSYNC_LOG_MAX_MB=20
DBSYNC_LOG_KEEP=5
DBSYNC_RETENTION_DAYS=90
